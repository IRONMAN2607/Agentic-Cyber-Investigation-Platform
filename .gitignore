# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime data: artifacts are potentially malicious, never commit them
data/
!data/.gitkeep

# Datasets are large and often licence-restricted; commit manifests only
datasets/**/raw/
datasets/**/*.pcap
datasets/**/*.csv

# Frontend
node_modules/
web/dist/

# OS
.DS_Store
Thumbs.db

# Knowledge graph: the primary artifacts are shared, but the AST cache,
# rendered HTML view and dated snapshots are regenerable via `graphify update .`
graphify-out/cache/
graphify-out/graph.html
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# IDE / local tooling
.claude/*.local.json
.claude/settings.local.json
.openclaude/
*.local
