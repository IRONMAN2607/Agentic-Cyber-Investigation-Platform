# Copy to .env and adjust. Never commit .env.
ACIP_ENVIRONMENT=dev
ACIP_DEBUG=true
ACIP_LOG_LEVEL=INFO
ACIP_LOG_FORMAT=console

# REQUIRED in prod: >=32 chars of high-entropy random data.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACIP_SECRET_KEY=

ACIP_DATABASE_URL=sqlite+aiosqlite:///./data/acip.db
# Postgres (Phase 5 onward): postgresql+asyncpg://acip:acip@localhost:5432/acip

ACIP_ARTIFACT_DIR=./data/artifacts
ACIP_MAX_ARTIFACT_BYTES=26214400
ACIP_MAX_INVESTIGATION_SECONDS=300

ACIP_CORS_ORIGINS=["http://localhost:5173"]

# Dev-only bootstrap account. Ignored when ACIP_ENVIRONMENT=prod.
ACIP_BOOTSTRAP_ADMIN_USERNAME=admin
ACIP_BOOTSTRAP_ADMIN_PASSWORD=changeme-dev-only
